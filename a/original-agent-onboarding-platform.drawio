<mxfile host="app.diagrams.net"><diagram name="Agent Onboarding Platform"><mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" page="1" pageWidth="1680" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g1" value="1. INTAKE AND APPROVAL (ServiceNow)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1F4E79;dashed=1;verticalAlign=top;align=left;spacingLeft=6;fontStyle=1;fontSize=12;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="480" height="330" as="geometry"/></mxCell><mxCell id="g2" value="2. ONBOARDING ORCHESTRATION" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7F3F00;dashed=1;verticalAlign=top;align=left;spacingLeft=6;fontStyle=1;fontSize=12;fontColor=#7F3F00;" vertex="1" parent="1"><mxGeometry x="520" y="20" width="340" height="500" as="geometry"/></mxCell><mxCell id="g3" value="3. IDENTITY AND SECRETS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#006100;dashed=1;verticalAlign=top;align=left;spacingLeft=6;fontStyle=1;fontSize=12;fontColor=#006100;" vertex="1" parent="1"><mxGeometry x="880" y="20" width="340" height="330" as="geometry"/></mxCell><mxCell id="g4" value="4. RUNTIME ENFORCEMENT (dev / qa / uat / prod)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4B2C83;dashed=1;verticalAlign=top;align=left;spacingLeft=6;fontStyle=1;fontSize=12;fontColor=#4B2C83;" vertex="1" parent="1"><mxGeometry x="880" y="380" width="760" height="470" as="geometry"/></mxCell><mxCell id="g5" value="5. GOVERNANCE AND POSTURE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9C0006;dashed=1;verticalAlign=top;align=left;spacingLeft=6;fontStyle=1;fontSize=12;fontColor=#9C0006;" vertex="1" parent="1"><mxGeometry x="1240" y="20" width="400" height="330" as="geometry"/></mxCell><mxCell id="g6" value="AGENT RUNTIMES" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#404040;dashed=1;verticalAlign=top;align=left;spacingLeft=6;fontStyle=1;fontSize=12;fontColor=#404040;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="480" height="470" as="geometry"/></mxCell><mxCell id="g7" value="6. OBSERVABILITY (OpenTelemetry end to end, traceparent = correlation ID) AND DASHBOARDS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#005A70;dashed=1;verticalAlign=top;align=left;spacingLeft=6;fontStyle=1;fontSize=12;fontColor=#005A70;" vertex="1" parent="1"><mxGeometry x="20" y="880" width="1620" height="190" as="geometry"/></mxCell><mxCell id="req" value="&lt;b&gt;Requester / Agent Owner&lt;/b&gt;&lt;br&gt;Human identity (Entra user)&lt;br&gt;Owner + backup owner" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#000000;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="200" height="90" as="geometry"/></mxCell><mxCell id="sn" value="&lt;b&gt;ServiceNow Catalog + Flow&lt;/b&gt;&lt;br&gt;Onboarding form&lt;br&gt;Tier-driven approvals&lt;br&gt;REST step to OMS&lt;br&gt;Callback handler" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#1F4E79;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="270" y="60" width="210" height="120" as="geometry"/></mxCell><mxCell id="cmdb" value="&lt;b&gt;ServiceNow CMDB&lt;/b&gt;&lt;br&gt;AI Agent CI per env&lt;br&gt;Status lifecycle&lt;br&gt;Owner, APIM, MCP, Oasis,&lt;br&gt;supervisor-worker relations" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#1F4E79;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="270" y="210" width="210" height="120" as="geometry"/></mxCell><mxCell id="tix" value="&lt;b&gt;ServiceNow Findings Queue&lt;/b&gt;&lt;br&gt;Oasis + Wiz findings&lt;br&gt;Recertify / change /&lt;br&gt;offboard requests" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#1F4E79;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="200" height="120" as="geometry"/></mxCell><mxCell id="oms" value="&lt;b&gt;Onboarding Microservice&lt;/b&gt;&lt;br&gt;Azure Container Apps / Functions&lt;br&gt;Own managed identity (least-priv Graph)&lt;br&gt;/classify  /onboard  /offboard&lt;br&gt;Idempotent, saga + compensation&lt;br&gt;Async 202 + callback" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#7F3F00;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="60" width="300" height="160" as="geometry"/></mxCell><mxCell id="ucf" value="&lt;b&gt;Use-Case Framework&lt;/b&gt;&lt;br&gt;Criticality: complexity x availability x data&lt;br&gt;Role: supervisor vs worker&lt;br&gt;Outputs approval chain, credential type,&lt;br&gt;rate-limit, guardrails, test depth, recert" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#7F3F00;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="250" width="300" height="120" as="geometry"/></mxCell><mxCell id="state" value="&lt;b&gt;Orchestration State Store&lt;/b&gt;&lt;br&gt;Job, checkpoints, profile version,&lt;br&gt;idempotency keys, onboarding audit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#7F3F00;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="400" width="300" height="100" as="geometry"/></mxCell><mxCell id="entra" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;Agent ID / App Reg / Service Principal&lt;br&gt;One identity per agent per env&lt;br&gt;Federated credential / managed identity&lt;br&gt;App roles + scopes, Conditional Access" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#006100;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="60" width="300" height="150" as="geometry"/></mxCell><mxCell id="kv" value="&lt;b&gt;Azure Key Vault&lt;/b&gt;&lt;br&gt;Certificates for non-Azure runtimes&lt;br&gt;Rotation per tier, agent Get only" style="rou