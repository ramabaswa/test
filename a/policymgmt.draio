    <mxCell id="e08" edge="1" parent="1" source="orchestrator" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#FFFFFF;" target="reconciler" value="5. Verify fulfillment">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e09" edge="1" parent="1" source="directory" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;dashed=1;strokeColor=#82B366;fontSize=12;labelBackgroundColor=#FFFFFF;" target="reconciler" value="Actual access / change observation">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e10" edge="1" parent="1" source="sailpoint" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;dashed=1;strokeColor=#9673A6;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;entryX=1;entryY=0;" target="reconciler" value="Approval / fulfillment events">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e11" edge="1" parent="1" source="policyModel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;" target="compiler" value="Approved policy structure">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e12" edge="1" parent="1" source="reconciler" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#FFFFFF;" target="compiler" value="6. Effective entitlement projection">
      <mxGeometry relative="1" as="geometry" />
