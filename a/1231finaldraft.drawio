    <mxCell id="guardrail_model" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#353F9A;fillColor=#F7F8FF;strokeWidth=1.5;fontSize=11;fontColor=#1C286E;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" value="&lt;b&gt;THE DUAL-GUARDRAIL MODEL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Two independent checks protect every transaction end-to-end.&lt;br&gt;&lt;br&gt;&lt;b&gt;1  User Intent Guard (OpenFGA)&lt;/b&gt;&lt;br&gt;Prevents unauthorized users from misusing the agent.&lt;br&gt;&lt;br&gt;&lt;b&gt;2  NHI Guard (OpenFGA)&lt;/b&gt;&lt;br&gt;Prevents the agent (NHI) from accessing any system or service if it is not allowed.&lt;br&gt;&lt;br&gt;&lt;b&gt;Oasis AAM context&lt;/b&gt;&lt;br&gt;Intent-aware policy + short-lived, least-privilege session controls can surround the guardrails." vertex="1">
      <mxGeometry height="220" width="245" x="1340" y="105" as="geometry" />
    </mxCell>
    <mxCell id="section2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#7078BA;fillColor=#FAFAFF;strokeWidth=1.5;fontSize=16;fontStyle=1;fontColor=#27347B;align=left;verticalAlign=top;spacingTop=8;spacingLeft=18;" value="2. DUAL-GUARDRAIL ACCESS WORKFLOW (EVERY TRANSACTION)" vertex="1">
