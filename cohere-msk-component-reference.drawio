        <mxCell id="60" value="&lt;b&gt;Pattern legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2563eb&quot;&gt;■ Target / push-to-Cohere&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#16a34a&quot;&gt;■ Pull from Cohere source&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#9333ea&quot;&gt;■ Bidirectional sync&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;- - Shared control/support path&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="1000" width="290" height="150" as="geometry" />
        </mxCell>
        <mxCell id="61" value="&lt;b&gt;Delivery invariants&lt;/b&gt;&lt;br&gt;• Key by member/request/authorization ID for ordering&lt;br&gt;• Assume at-least-once; consumers and target writes must be idempotent&lt;br&gt;• Never place secrets or unnecessary PHI in events/logs&lt;br&gt;• Correlation ID links request, Kafka record, API call, and decision&lt;br&gt;• Reconcile source-of-truth conflicts explicitly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1695" y="890" width="330" height="230" as="geometry" />
        </mxCell>
      </root>
