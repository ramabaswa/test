        <mxCell id="71" value="&lt;b&gt;Pattern A — Target / Push&lt;/b&gt;&lt;br&gt;System event or CDC → MSK → transform → target API/DB&lt;br&gt;&lt;b&gt;Best for:&lt;/b&gt; near-real-time delivery and fan-out&lt;br&gt;&lt;b&gt;Controls:&lt;/b&gt; outbox, idempotent sink, retry/DLQ, rate limit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="30" y="1220" width="650" height="180" as="geometry" />
        </mxCell>
        <mxCell id="72" value="&lt;b&gt;Pattern B — Pull from Source&lt;/b&gt;&lt;br&gt;scheduler → source API/FHIR history → watermark → MSK&lt;br&gt;&lt;b&gt;Best for:&lt;/b&gt; source has no webhook/event stream&lt;br&gt;&lt;b&gt;Controls:&lt;/b&gt; ETag/delta token, pagination, overlap window, reconciliation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="720" y="1220" width="650" height="180" as="geometry" />
        </mxCell>
        <mxCell id="73" value="&lt;b&gt;Pattern C — Bidirectional&lt;/b&gt;&lt;br&gt;command topic/API → Cohere/vendor → status/result topic&lt;br&gt;&lt;b&gt;Best for:&lt;/b&gt; prior-auth lifecycle and request/response&lt;br&gt;&lt;b&gt;Controls:&lt;/b&gt; correlation ID, saga state, conflict owner, loop prevention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#581c87;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1410" y="1220" width="740" height="180" as="geometry" />
        </mxCell>
