        <mxCell id="invalid" edge="1" parent="1" source="n8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#B42318;strokeWidth=2;dashed=1;endArrow=block;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=1;entryX=1;entryY=0;" target="vendorFailure" value="Invalid / incompatible">
