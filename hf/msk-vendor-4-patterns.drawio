        <mxCell id="note2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#CA8A04;fontColor=#795C21;fontSize=12;align=left;spacing=12;" value="&lt;b&gt;Separate positions and retention&lt;/b&gt;&lt;br&gt;Source capture position ≠ publication evidence ≠ consumer-group offsets ≠ vendor business-applied versions. Topic data retention and inactive group-offset retention are separate. Retaining offsets does not retain expired records." vertex="1">
          <mxGeometry height="100" width="950" x="1000" y="1210" as="geometry" />
        </mxCell>
        <mxCell id="note3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0EBFA;strokeColor=#CBBCE7;fontColor=#554376;fontSize=12;align=left;spacing=12;" value="&lt;b&gt;Commit model shown: apply-before-commit&lt;/b&gt;&lt;br&gt;Crash after target application but before commit can cause replay; vendor target operations must be idempotent. If choosing durable inbox-before-commit instead, add an inbox checkpoint and independently monitor vendor business-applied backlog." vertex="1">
          <mxGeometry height="100" width="930" x="40" y="1330" as="geometry" />
        </mxCell>
        <mxCell id="note4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F0;strokeColor=#E7B7B3;fontColor=#7A271A;fontSize=12;align=left;spacing=12;" value="&lt;b&gt;Scope and guardrails&lt;/b&gt;&lt;br&gt;Direct Kafka access requires vendor certification. Workload identity is separate from OIDC/CIAM human login. No relay push or business-result return is included. Do not expose raw PHI CDC topics. Missing history requires controlled repair/baseline, not silent skipping." vertex="1">
          <mxGeometry height="100" width="950" x="1000" y="1330" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#536B7D;" value="Legend: solid arrows = event data / processing / durable offset commit; dashed blue = polling or position request; dashed gray = provisioning configuration; dashed red = failure; dashed amber = recovery coordination. Enterprise publication does not wait for vendor readiness." vertex="1">
          <mxGeometry height="55" width="1890" x="45" y="1450" as="geometry" />
