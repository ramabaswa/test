          <mxGeometry as="geometry" x="45" y="18" width="1800" height="42"/>
        </mxCell>
        <mxCell id="sub" value="Enterprise owns ingestion and ETL: vendor cursor → inbound topic → transform/load checkpoint → target reconciliation." style="text;html=1;align=left;fontSize=15;fontColor=#536B7D;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="47" y="62" width="1800" height="30"/>
        </mxCell>
        <mxCell id="L1" value="COHERE HEALTH / OTHER VENDOR — SOURCE" style="swimlane;html=1;horizontal=0;startSize=46;fillColor=#7C3AED;swimlaneFillColor=#F8FBFC;fontColor=#FFFFFF;fontStyle=1;fontSize=13;collapsible=0;separatorColor=#D5E4E9;strokeColor=#A8C6D0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="105" width="1910" height="220"/>
        </mxCell>
        <mxCell id="L2" value="YOUR COMPANY — SOURCE ADAPTER / INTEGRATION" style="swimlane;html=1;horizontal=0;startSize=46;fillColor=#2563EB;swimlaneFillColor=#F8FBFC;fontColor=#FFFFFF;fontStyle=1;fontSize=13;collapsible=0;separatorColor=#D5E4E9;strokeColor=#A8C6D0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="350" width="1910" height="220"/>
        </mxCell>
        <mxCell id="L3" value="YOUR COMPANY — AMAZON MSK PRODUCT" style="swimlane;html=1;horizontal=0;startSize=46;fillColor=#1E293B;swimlaneFillColor=#F8FBFC;fontColor=#FFFFFF;fontStyle=1;fontSize=13;collapsible=0;separatorColor=#D5E4E9;strokeColor=#A8C6D0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="595" width="1910" height="220"/>
        </mxCell>
        <mxCell id="L4" value="YOUR COMPANY — ENTERPRISE ETL / TARGETS" style="swimlane;html=1;horizontal=0;startSize=46;fillColor=#0798B5;swimlaneFillColor=#F8FBFC;fontColor=#FFFFFF;fontStyle=1;fontSize=13;collapsible=0;separatorColor=#D5E4E9;strokeColor=#A8C6D0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="840" width="1910" height="220"/>
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;1. Create vendor change&lt;/b&gt;&lt;br&gt;Expose API, webhook, token/timestamp or changelog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#102A43;fontSize=11;align=center;verticalAlign=middle;spacing=8;" parent="L1" vertex="1">
          <mxGeometry as="geometry" x="55" y="48" width="230" height="118"/>
        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;2. Authorize extraction&lt;/b&gt;&lt;br&gt;API identity, scope, rate and source contract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#102A43;fontSize=11;align=center;verticalAlign=middle;spacing=8;" parent="L1" vertex="1">
          <mxGeometry as="geometry" x="345" y="48" width="245" height="118"/>
        </mxCell>
        <mxCell id="b13" value="&lt;b&gt;13. Optional receipt&lt;/b&gt;&lt;br&gt;Only when vendor protocol requires it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#102A43;fontSize=11;align=center;verticalAlign=middle;spacing=8;" parent="L1" vertex="1">
          <mxGeometry as="geometry" x="1615" y="48" width="230" height="118"/>
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;3. Poll / subscribe&lt;/b&gt;&lt;br&gt;Source connector reads saved source cursor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontColor=#102A43;fontSize=11;align=center;verticalAlign=middle;spacing=8;" parent="L2" vertex="1">
          <mxGeometry as="geometry" x="345" y="48" width="245" height="118"/>
        </mxCell>
        <mxCell id="b4" value="&lt;b&gt;4. Land / validate&lt;/b&gt;&lt;br&gt;Raw boundary, schema, duplicate and content checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=2;fontColor=#102A43;fontSize=11;align=center;verticalAlign=middle;spacing=8;" parent="L2" vertex="1">
          <mxGeometry as="geometry" x="650" y="48" width="250" height="118"/>
        </mxCell>
        <mxCell id="b5" value="&lt;b&gt;5. Normalize event&lt;/b&gt;&lt;br&gt;Map model; add cursor/version, event ID and trace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=2;fontColor=#102A43;fontSize=11;align=center;verticalAlign=middle;spacing=8;" parent="L2" vertex="1">
          <mxGeometry as="geometry" x="960" y="48" width="260" height="118"/>
        </mxCell>
        <mxCell id="b8" value="&lt;b&gt;8. Advance source cursor&lt;/b&gt;&lt;br&gt;After durable MSK publication; independent of ETL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=2;fontColor=#102A43;fontSize=11;align=center;verticalAlign=middle;spacing=8;" parent="L2" vertex="1">
          <mxGeometry as="geometry" x="1615" y="48" width="230" height="118"/>
        </mxCell>
        <mxCell id="b6" value="&lt;b&gt;6. Publish inbound topic&lt;/b&gt;&lt;br&gt;Vendor-inbound or approved canonical event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;fontColor=#102A43;fontSize=11;align=center;verticalAlign=middle;spacing=8;" parent="L3" vertex="1">
          <mxGeometry as="geometry" x="960" y="48" width="260" height="118"/>
        </mxCell>
        <mxCell id="b7" value="&lt;b&gt;7. Govern / observe&lt;/b&gt;&lt;br&gt;Schema, retention, ACL, partitions and freshness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;fontColor=#102A43;fontSize=11;align=center;verticalAlign=middle;spacing=8;" parent="L3" vertex="1">
          <mxGeometry as="geometry" x="1280" y="48" width="270" height="118"/>
        </mxCell>
        <mxCell id="b9" value="&lt;b&gt;9. ETL extract&lt;/b&gt;&lt;br&gt;Consume topic; land raw/staged records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0798B5;strokeWidth=2;fontColor=#102A43;fontSize=11;align=center;verticalAlign=middle;spacing=8;" parent="L4" vertex="1">
          <mxGeometry as="geometry" x="625" y="48" width="245" height="118"/>
        </mxCell>
        <mxCell id="b10" value="&lt;b&gt;10. Transform / validate&lt;/b&gt;&lt;br&gt;Mappings, quality, codes, joins and merge rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0798B5;strokeWidth=2;fontColor=#102A43;fontSize=11;align=center;verticalAlign=middle;spacing=8;" parent="L4" vertex="1">
          <mxGeometry as="geometry" x="930" y="48" width="250" height="118"/>
        </mxCell>
        <mxCell id="b11" value="&lt;b&gt;11. Load / merge target&lt;/b&gt;&lt;br&gt;Idempotent upsert/delete into SOR or lakehouse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0798B5;strokeWidth=2;fontColor=#102A43;fontSize=11;align=center;verticalAlign=middle;spacing=8;" parent="L4" vertex="1">
          <mxGeometry as="geometry" x="1240" y="48" width="250" height="118"/>
        </mxCell>
        <mxCell id="b12" value="&lt;b&gt;12. Reconcile / repair&lt;/b&gt;&lt;br&gt;Detect gaps, stale records and failed effects" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B42318;strokeWidth=2;fontColor=#102A43;fontSize=11;align=center;verticalAlign=middle;spacing=8;" parent="L4" vertex="1">
          <mxGeometry as="geometry" x="1550" y="48" width="295" height="118"/>
        </mxCell>
        <mxCell id="berr" value="&lt;b&gt;Error path&lt;/b&gt;&lt;br&gt;retry → quarantine/DLQ → corrected mapping/source → approved replay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F0;strokeColor=#B42318;strokeWidth=2;fontColor=#102A43;fontSize=11;align=center;verticalAlign=middle;spacing=8;" parent="L3" vertex="1">
          <mxGeometry as="geometry" x="55" y="48" width="520" height="118"/>
        </mxCell>
        <mxCell id="bnote" value="&lt;b&gt;Separate state&lt;/b&gt;&lt;br&gt;Source cursor proves ingestion. ETL offset/checkpoint proves transformed load. Reconciliation proves business completeness." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#CA8A04;strokeWidth=2;fontColor=#102A43;fontSize=11;align=center;verticalAlign=middle;spacing=8;" parent="L4" vertex="1">
