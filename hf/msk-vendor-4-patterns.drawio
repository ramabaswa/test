        <mxCell id="note1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F6F8;strokeColor=#9BD9E2;fontColor=#24515A;fontSize=12;align=left;spacing=12;" value="&lt;b&gt;Independent state:&lt;/b&gt; enterprise source-capture position ≠ publication evidence ≠ vendor delivery offsets ≠ vendor business-applied versions.&lt;br&gt;Kafka may store vendor consumer-group commits even though enterprise does not maintain the vendor business-delta ledger." vertex="1">
          <mxGeometry height="90" width="880" x="40" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="note2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#CA8A04;fontColor=#795C21;fontSize=12;align=left;spacing=12;" value="&lt;b&gt;Checkpoint model shown:&lt;/b&gt; apply-before-commit. Crash after target apply but before offset commit can cause replay; vendor application must be idempotent.&lt;br&gt;If using durable inbox-before-commit instead, add a separate inbox checkpoint and monitor target-applied backlog independently." vertex="1">
          <mxGeometry height="90" width="900" x="950" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="note3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F0;strokeColor=#E7B7B3;fontColor=#7A271A;fontSize=12;align=left;spacing=12;" value="&lt;b&gt;Missing position / expired history:&lt;/b&gt; fail visibly and invoke agreed repair or baseline procedure. Do not silently jump to latest.&lt;br&gt;Timestamps alone are not a general recovery guarantee. Vendors must handle equal-time, late and out-of-order changes using the publication contract." vertex="1">
          <mxGeometry height="90" width="880" x="40" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="note4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0EBFA;strokeColor=#CBBCE7;fontColor=#554376;fontSize=12;align=left;spacing=12;" value="&lt;b&gt;Reconciliation and scope:&lt;/b&gt; enterprise verifies publication completeness; vendor verifies its target synchronization. Kafka offsets alone do not prove business completeness.&lt;br&gt;No mandatory return event or enterprise ETL of vendor data is implied. Cohere Health direct Kafka support remains subject to confirmation." vertex="1">
          <mxGeometry height="90" width="900" x="950" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#536B7D;" value="Legend: solid arrows = event data or processing flow; dashed blue = vendor-initiated poll request; dashed red = failure path. Enterprise publication does not wait for vendor consumption. Daily publication remains batch cadence even when transported through Kafka." vertex="1">
          <mxGeometry height="50" width="1800" x="45" y="1360" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
