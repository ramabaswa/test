ometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="m5" target="m6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="Register" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="m6" target="m6o"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="Unclaimed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="m5" target="m7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="m7" target="m7e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="Cert cycle due" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="m4" target="m8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="m8" target="m9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="m9" target="m10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="m10" target="m11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="m11" target="m11e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="m10" target="m12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="m12" target="m13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="m13" target="m14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="m14" target="m14e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="Notes: Discovery covers sources the registry cannot see on its own (low-code/no-code tools, SaaS-embedded agents, service accounts). Detection depth depends on each vendor&#x27;s APIs - validate per platform in a proof of concept before relying on it." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacingLeft=6;spacingTop=4;fillColor=#fffbe6;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="920" width="1100" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="2 Enterprise Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Enterprise Architecture - Centralized Agent Identity Governance (capability / layer view)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Governance &amp;&lt;br&gt;Policy" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=50;fontStyle=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1250" height="110" as="geometry"/></mxCell><mxCell id="c4" value="AI Governance Policy &amp;&lt;br&gt;Agent Risk Tiers" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="90" y="80" width="360" height="70" as="geometry"/></mxCell><mxCell id="c5" value="Architecture Review Board &amp;&lt;br&gt;Exception Process" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="480" y="80" width="360" height="70" as="geometry"/></mxCell><mxCell id="c6" value="Regulatory, Privacy &amp;&lt;br&gt;Audit Requirements" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="870" y="80" width="360" height="70" as="geometry"/></mxCell><mxCell id="c7" value="CENTRAL CONTROL PLANE&lt;br&gt;(new capability)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=50;fontStyle=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="1250" height="170" as="geometry"/></mxCell><mxCell id="c8" value="Enterprise Agent Registry &amp; Catalog&lt;br&gt;ServiceNow AI Control Tower / CMDB&lt;br&gt;System of record: EAID + native-ID crosswalk" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="90" y="215" width="275" height="120" as="geometry"/></mxCell><mxCell id="c9" value="Access Governance &amp; Certification&lt;br&gt;SailPoint (Agent Fabric - under evaluation)&lt;br&gt;Ownership, entitlements, reviews" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="385" y="215" width="275" height="120" as="geometry"/></mxCell><mxCell id="c10" value="NHI Discovery &amp; Posture&lt;br&gt;Oasis / SlashID (future) or Entra Agent 365&lt;br&gt;Finds unregistered identities &amp; credentials" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="680" y="215" width="275" height="120" as="geometry"/></mxCell><mxCell id="c11" value="Governance Workflow &amp; Policy&lt;br&gt;Registration, approval, lifecycle,&lt;br&gt;exceptions, remediation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="975" y="215" width="275" height="120" as="geometry"/></mxCell><mxCell id="c12" value="Identity Planes&lt;br&gt;(issue identities;&lt;br&gt;stay distributed)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=50;fontStyle=1;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="1250" height="130" as="geometry"/></mxCell><mxCell id="c13" value="Workforce &amp; Agent Identity&lt;br&gt;Microsoft Entra (Agent 365 / Agent ID)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="90" y="405" width="275" height="80" as="geometry"/></mxCell><mxCell id="c14" value="Customer Identity (CIAM)&lt;br&gt;Okta, AWS Cognito&lt;br&gt;Delegated end-user authority" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="385" y="405" width="275" height="80" as="geometry"/></mxCell><mxCell id="c15" value="Cloud Workload Identity&lt;br&gt;AWS IAM / STS roles" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="680" y="405" width="275" height="80" as="geometry"/></mxCell><mxCell id="c16" value="Secrets &amp; Credential Vault&lt;br&gt;Credentials stay in home system" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="975" y="405" width="275" height="80" as="geometry"/></mxCell><mxCell id="c17" value="Agent Build&lt;br&gt;Platforms&lt;br&gt;(create agents)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=50;fontStyle=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="530" width="1250" height="130" as="geometry"/></mxCell><mxCell id="c18" value="Pro-code&lt;br&gt;AWS AgentCore + Bedrock" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="90" y="555" width="215" height="80" as="geometry"/></mxCell><mxCell id="c19" value="Low-code&lt;br&gt;Workato AI Studio" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="320" y="555" width="215" height="80" as="geometry"/></mxCell><mxCell id="c20" value="No-code / AI-assisted&lt;br&gt;Cursor" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="550" y="555" width="215" height="80" as="geometry"/></mxCell><mxCell id="c21" value="SaaS-embedded&lt;br&gt;Salesforce Agentforce" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="780" y="555" width="215" height="80" as="geometry"/></mxCell><mxCell id="c22" value="Future platforms&lt;br&gt;(register before go-live)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="555" width="215" height="80" as="geometry"/></mxCell><mxCell id="c23" value="Tools &amp; Data&lt;br&gt;Access" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=50;fontStyle=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="1250" height="110" as="geometry"/></mxCell><mxCell id="c24" value="Enterprise MCP Gateway / Servers" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="90" y="705" width="360" height="60" as="geometry"/></mxCell><mxCell id="c25" value="Enterprise APIs &amp; Services" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="480" y="705" width="360" height="60" as="geometry"/></mxCell><mxCell id="c26" value="Data Platforms &amp;&lt;br&gt;Event Streaming (e.g., Kafka/MSK)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="870" y="705" width="360" height="60" as="geometry"/></mxCell><mxCell id="c27" value="Cross-cutting" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=50;fontStyle=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="810" width="1250" height="100" as="geometry"/></mxCell><mxCell id="c28" value="Observability, Security Posture &amp; Audit - SIEM, APM, cloud / SaaS posture tools (candidates under evaluation)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="90" y="830" width="1130" height="60" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Authority by function (hypothesis - validate in POC)&lt;/b&gt;&lt;table border=&#x27;1&#x27; cellpadding=&#x27;3&#x27; style=&#x27;border-collapse:collapse;font-size:11px;width:100%&#x27;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Function&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Authoritative system&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Agent record, EAID, catalog, lifecycle&lt;/td&gt;&lt;td&gt;ServiceNow&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Access certification &amp;amp; entitlements&lt;/td&gt;&lt;td&gt;SailPoint&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Microsoft-estate agent identity&lt;/td&gt;&lt;td&gt;Entra Agent 365 / Agent ID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Cross-platform NHI &amp;amp; credential discovery&lt;/td&gt;&lt;td&gt;Oasis / SlashID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Native credentials &amp;amp; runtime authZ&lt;/td&gt;&lt;td&gt;Each home platform&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Customer-delegated authority&lt;/td&gt;&lt;td&gt;Okta / Cognito&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fillColor=#ffffff;strokeColor=#666666;rounded=1;spacing=6;overflow=fill;" vertex="1" parent="1"><mxGeometry x="1300" y="60" width="340" height="250" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Design principles&lt;/b&gt;&lt;br&gt;1. Distributed issuance, centralized record: platforms mint identities; the registry holds the EAID and a pointer to each.&lt;br&gt;2. Register-first (preventive) plus discover-and-reconcile (detective).&lt;br&gt;3. Secrets never copied into the registry.&lt;br&gt;4. Agent identity is separate from delegated user identity (CIAM).&lt;br&gt;5. Canonical schema stays vendor-neutral so products can be swapped as standards mature.&lt;br&gt;&lt;br&gt;&lt;b&gt;Caveat:&lt;/b&gt; vendor capabilities for Control Tower, Agent Fabric and Agent 365 should be verified against current documentation; no single vendor is assumed to cover every function." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacingLeft=6;spacingTop=4;fillColor=#fffbe6;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1"><mxGeometry x="1300" y="330" width="340" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="3 Solution Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Solution Architecture - Centralized Agent Registry (ServiceNow as system of record)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="36" as="geometry"/></mxCell><mxCell id="A3" value="Platform templates / landing zones&lt;br&gt;EAID tag mandatory" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="300" height="70" as="geometry"/></mxCell><mxCell id="A1" value="Self-service portal&lt;br&gt;ServiceNow catalog request" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="260" height="70" as="geometry"/></mxCell><mxCell id="A2" value="CI/CD &amp; IaC gate&lt;br&gt;pipeline check: EAID exists &amp; approved" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="990" y="60" width="270" height="70" as="geometry"/></mxCell><mxCell id="G" value="Agent Build Platforms &amp; Identity Sources" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="300" height="520" as="geometry"/></mxCell><mxCell id="c3" value="AWS AgentCore + Bedrock" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="G"><mxGeometry x="20" y="40" width="260" height="55" as="geometry"/></mxCell><mxCell id="c4" value="Workato AI Studio" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="G"><mxGeometry x="20" y="107" width="260" height="55" as="geometry"/></mxCell><mxCell id="c5" value="Cursor-built agents" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="G"><mxGeometry x="20" y="174" width="260" height="55" as="geometry"/></mxCell><mxCell id="c6" value="Salesforce Agentforce" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="G"><mxGeometry x="20" y="241" width="260" height="55" as="geometry"/></mxCell><mxCell id="c7" value="Microsoft Entra (Agent 365 / Agent ID)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="G"><mxGeometry x="20" y="308" width="260" height="55" as="geometry"/></mxCell><mxCell id="c8" value="Okta / AWS Cognito (CIAM)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="G"><mxGeometry x="20" y="375" width="260" height="55" as="geometry"/></mxCell><mxCell id="c9" value="NHI platform (Oasis / SlashID)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="G"><mxGeometry x="20" y="442" width="260" height="55" as="geometry"/></mxCell><mxCell id="C1" value="Connectors / Collectors&lt;br&gt;API pulls, webhooks, scheduled scans (per platform)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="400" y="230" width="240" height="90" as="geometry"/></mxCell><mxCell id="C2" value="Event Bus&lt;br&gt;(e.g., EventBridge / Kafka)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="400" y="370" width="240" height="80" as="geometry"/></mxCell><mxCell id="C3" value="Normalization &amp; Reconciliation Service&lt;br&gt;Maps native objects to canonical schema; matches native ID to EAID; flags unmatched" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="400" y="500" width="240" height="110" as="geometry"/></mxCell><mxCell id="D" value="ServiceNow - Agent Registry (system of record)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="560" height="520" as="geometry"/></mxCell><mxCell id="c10" value="Agent Registry table&lt;br&gt;EAID, owner, sponsor, purpose, state" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="D"><mxGeometry x="20" y="45" width="250" height="95" as="geometry"/></mxCell><mxCell id="c11" value="Crosswalk table&lt;br&gt;native ID / platform / credential ref  &lt;-&gt;  EAID" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#