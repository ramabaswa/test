    <!-- TITLE -->
    <mxCell id="title" parent="1" vertex="1"
      style="text;html=1;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#102A43;"
      value="PATTERN 4 — BIDIRECTIONAL — Scenario A: Enterprise Push / Vendor Result / Enterprise Pull">
      <mxGeometry x="40" y="15" width="2110" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="subtitle" parent="1" vertex="1"
      style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#536B7D;"
      value="Enterprise pushes authorized data. Vendor processes and durably publishes results, then notifies availability. Enterprise pulls results and applies its workflow. Each direction has independent identity, retention, checkpoints and recovery.">
      <mxGeometry x="42" y="70" width="2100" height="55" as="geometry"/>
    </mxCell>

    <!-- LANE 1: ENTERPRISE DOMAIN / OUTBOUND INTEGRATION -->
    <mxCell id="L1" parent="1" vertex="1"
      style="swimlane;html=1;horizontal=1;startSize=36;fillColor=#0798B5;swimlaneFillColor=#F3FAFB;fontColor=#FFFFFF;fontStyle=1;fontSize=14;collapsible=0;strokeColor=#A8C6D0;"
      value="YOUR COMPANY — DOMAIN / SOURCE SYSTEMS / OUTBOUND INTEGRATION">
      <mxGeometry x="40" y="140" width="2110" height="220" as="geometry"/>
    </mxCell>

    <mxCell id="n1" parent="L1" vertex="1"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0798B5;strokeWidth=2;fontColor=#102A43;fontSize=12;spacing=10;"
      value="&lt;b&gt;1. Commit business trigger&lt;/b&gt;&lt;br&gt;Authoritative source transaction&lt;br&gt;Workflow / correlation identity&lt;br&gt;Source version and requested action">
