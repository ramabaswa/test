      value="&lt;b&gt;Vendor recovery responsibility&lt;/b&gt;&lt;br&gt;Accepted-but-unprocessed backlog&lt;br&gt;Result outbox publication retry&lt;br&gt;Feed retention / replay and notification retry&lt;br&gt;Separate processing failure from delivery failure">
      <mxGeometry x="1590" y="65" width="480" height="150" as="geometry"/>
    </mxCell>

