      value="&lt;b&gt;2. Capture and build authorized event&lt;/b&gt;&lt;br&gt;CDC / transactional outbox&lt;br&gt;Schema validation and PHI projection&lt;br&gt;Event ID, entity version and causation">
      <mxGeometry x="390" y="65" width="310" height="115" as="geometry"/>
    </mxCell>

    <mxCell id="n3" parent="L1" vertex="1"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0798B5;strokeWidth=2;fontColor=#102A43;fontSize=12;spacing=10;"
      value="&lt;b&gt;3. Publish outbound event&lt;/b&gt;&lt;br&gt;Enterprise producer writes approved topic&lt;br&gt;Persist publication evidence&lt;br&gt;Track expected workflow response">
      <mxGeometry x="780" y="65" width="310" height="115" as="geometry"/>
    </mxCell>

    <mxCell id="conversation" parent="L1" vertex="1"
