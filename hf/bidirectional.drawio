    </mxCell>

    <mxCell id="platformControls" parent="L2" vertex="1"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FC;strokeColor=#2867BB;fontColor=#102A43;fontSize=12;spacing=10;"
      value="&lt;b&gt;Provision and govern before runtime&lt;/b&gt;&lt;br&gt;Separate producer / consumer identities and permissions&lt;br&gt;Encryption, partition strategy, retention and capacity&lt;br&gt;Topic/group scope; schema distribution; monitoring&lt;br&gt;Platform team owns MSK; integration owns adapters">
      <mxGeometry x="1590" y="50" width="480" height="145" as="geometry"/>
    </mxCell>

    <!-- LANE 3: ENTERPRISE DELIVERY AND RETURN ADAPTERS -->
    <mxCell id="L3" parent="1" vertex="1"
