    </mxCell>

    <!-- IMPLEMENTATION NOTES -->
    <mxCell id="note1" parent="1" vertex="1"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F6F8;strokeColor=#9BD9E2;fontColor=#24515A;fontSize=12;align=left;spacing=12;"
      value="&lt;b&gt;Scenario A boundary&lt;/b&gt;&lt;br&gt;Outbound is enterprise-managed push, not vendor Kafka pull. Return is enterprise-initiated pull from a durable vendor result source, not vendor push to enterprise S3. Notification is a separate availability signal. No S3 route or automatic enterprise republish loop is included.">
      <mxGeometry x="40" y="1480" width="1030" height="100" as="geometry"/>
    </mxCell>

    <mxCell id="note2" parent="1" vertex="1"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#CA8A04;fontColor=#795C21;fontSize=12;align=left;spacing=12;"
      value="&lt;b&gt;Independent positions&lt;/b&gt;&lt;br&gt;Enterprise capture/publication → outbound relay offsets → vendor accepted/applied state → vendor result publication → enterprise extraction cursor → inbound consumer offsets → enterprise applied state. None is a substitute for another. Extraction can advance independently of downstream application after safe publication.">
      <mxGeometry x="1100" y="1480" width="1050" height="100" as="geometry"/>
    </mxCell>

    <mxCell id="note3" parent="1" vertex="1"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0EBFA;strokeColor=#CBBCE7;fontColor=#554376;fontSize=12;align=left;spacing=12;"
      value="&lt;b&gt;Failure / replay controls&lt;/b&gt;&lt;br&gt;Use bounded retries, backpressure, restricted quarantine and approved replay at each boundary. Preserve event/result IDs across retries. A crash after applying but before committing can replay work. Advance only safe contiguous positions. Retained-history loss requires controlled repair or baseline, never silent skipping.">
      <mxGeometry x="40" y="1600" width="1030" height="110" as="geometry"/>
    </mxCell>

    <mxCell id="note4" parent="1" vertex="1"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F0;strokeColor=#E7B7B3;fontColor=#7A271A;fontSize=12;align=left;spacing=12;"
      value="&lt;b&gt;Notification and source-cursor safety&lt;/b&gt;&lt;br&gt;Periodic catch-up protects against lost notifications. Never advance the vendor-source cursor past unpersisted results. Invalid records require a defined durable disposition before advancing a fetched range. Result feed retention and notification retention are separate. Timestamp-only resume is not a general correctness guarantee.">
      <mxGeometry x="1100" y="1600" width="1050" height="110" as="geometry"/>
    </mxCell>

    <mxCell id="note5" parent="1" vertex="1"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FC;strokeColor=#B8CDEA;fontColor=#24466E;fontSize=12;align=left;spacing=12;"
      value="&lt;b&gt;Vendor capability / identity / authority confirmation&lt;/b&gt;&lt;br&gt;Confirm intake API, durable result-feed access, notification transport, authentication, idempotency and recovery support. A vendor Kafka result topic is one possible feed implementation only if certified; otherwise use an agreed pull API/changelog. Separate human OIDC/CIAM from workload credentials. Enforce PHI scope, field authority, origin/causation and version rules to prevent unauthorized updates and feedback loops.">
      <mxGeometry x="40" y="1730" width="2110" height="100" as="geometry"/>
    </mxCell>

    <mxCell id="legend" parent="1" vertex="1"
      style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#536B7D;"
      value="Legend: solid teal = outbound event flow; solid purple = vendor processing / returned result data; dashed blue = notification or pull control; dashed green = durable acceptance / publication confirmation. Numbering reflects logical milestones; vendor processing and enterprise delivery checkpointing may proceed independently after durable acceptance.">
      <mxGeometry x="45" y="1840" width="2100" height="50" as="geometry"/>
    </mxCell>

  </root>
</mxGraphModel>
