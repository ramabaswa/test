      value="&lt;b&gt;Conversation contract&lt;/b&gt;&lt;br&gt;workflowId / correlationId; eventId; causationId&lt;br&gt;entityId; sourceVersion; resultId / resultVersion&lt;br&gt;Accepted / processing / applied / rejected are distinct states&lt;br&gt;Define permitted transitions, timeout and authoritative fields">
      <mxGeometry x="1180" y="55" width="890" height="135" as="geometry"/>
    </mxCell>

    <!-- LANE 2: ENTERPRISE MSK -->
    <mxCell id="L2" parent="1" vertex="1"
