        <mxCell id="e27" edge="1" parent="1" source="recon" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" target="obs" value="Drift and completion events">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e28" edge="1" parent="1" source="recon" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" target="sp" value="Review / fulfillment result">
          <mxGeometry relative="1" x="0.1292" as="geometry">
            <Array as="points">
              <mxPoint x="1925" y="480" />
              <mxPoint x="1110" y="480" />
              <mxPoint x="1110" y="255" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sec" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F5F5F5;strokeColor=#666666;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="SECURITY AND FAILURE CONTRACTS&#xa;Per-connector identities with least privilege; protect mapping-write/admin APIs; no secrets in catalog records. Discovery is untrusted input until verified. Track desired state separately from observed/effective state. Define stale-cache limits by risk; fail closed for high-risk operations. Revoke/retire is incomplete until required target actions are verified. Store timestamps and retain old identifier mappings after merge, migration and retirement." vertex="1">
          <mxGeometry height="150" width="2090" x="55" y="1380" as="geometry" />
        </mxCell>
        <mxCell id="scale" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F5F5F5;strokeColor=#666666;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="DEPLOYMENT CHOICE: custom yellow modules may share ONE integration service and its job infrastructure. Keep ServiceNow/SailPoint out of the synchronous tool-call path. Prefer existing native integrations and schema before custom implementation. Runtime projection is separate from enterprise business authority; use measured freshness budgets, not claims of instant cross-cloud consistency." vertex="1">
          <mxGeometry height="110" width="2090" x="55" y="1560" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="4" name="04 | Canonical identity and relationship model">
    <mxGraphModel dx="4375" dy="2474" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#DAE8FC;strokeColor=#666666;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="04 | Canonical identity and relationship model&#xa;Proposed logical schema—not vendor table or API names. Centralized repository means governed linked records, not a universal security principal." vertex="1">
          <mxGeometry height="90" width="2120" x="35" y="25" as="geometry" />
        </mxCell>
        <mxCell id="agent" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#DAE8FC;strokeColor=#666666;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="ENTERPRISE AGENT&#xa;PK enterpriseAgentId (opaque, immutable)&#xa;ServiceNow record reference; displayName&#xa;Business purpose; accountable/technical owners&#xa;Criticality; sanction status; desired lifecycle&#xa;Stable across approved ownership/platform changes" vertex="1">
          <mxGeometry height="230" width="590" x="55" y="170" as="geometry" />
        </mxCell>
        <mxCell id="plat" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#D5E8D4;strokeColor=#666666;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="PLATFORM AGENT RECORD&#xa;PK platformRecordId; FK enterpriseAgentId&#xa;platformType + authorityScope + nativeAgentId&#xa;Native object type; source evidence; lastObservedAt&#xa;Observed state; original identifiers retained&#xa;One enterprise agent may have multiple records" vertex="1">
          <mxGeometry height="230" width="590" x="805" y="170" as="geometry" />
        </mxCell>
        <mxCell id="dep" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#D5E8D4;strokeColor=#666666;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="DEPLOYMENT&#xa;PK deploymentId; FK platformRecordId&#xa;Environment; account/tenant/org; region&#xa;Endpoint reference and version reference&#xa;Observed deployment state&#xa;Dev/prod permissions remain separate" vertex="1">
          <mxGeometry height="230" width="590" x="1555" y="170" as="geometry" />
        </mxCell>
        <mxCell id="binding" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#666666;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="VERIFIED IDENTITY BINDING&#xa;PK bindingId; FK deploymentId&#xa;identityProvider + authorityScope + principalId&#xa;principalType + relationshipType&#xa;Verification status, evidence and verifier&#xa;validFrom / validTo; shared identity flag" vertex="1">
          <mxGeometry height="250" width="590" x="805" y="660" as="geometry" />
        </mxCell>
        <mxCell id="principal" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#D5E8D4;strokeColor=#666666;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="NATIVE PRINCIPAL / CLIENT REFERENCE&#xa;Entra tenant + object ID; AgentCore workload ARN&#xa;AWS IAM role ARN; OIDC issuer + subject&#xa;SaaS org + native identity ID&#xa;OAuth client may serve multiple agents&#xa;Native issuer remains authority" vertex="1">
          <mxGeometry height="250" width="590" x="1555" y="660" as="geometry" />
        </mxCell>
        <mxCell id="access" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E1D5E7;strokeColor=#666666;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="ACCESS / GOVERNANCE RELATIONSHIP&#xa;enterpriseAgentId + bindingId + target reference&#xa;Approved entitlement vs observed entitlement&#xa;SailPoint review reference and decision&#xa;Fulfillment status; last verified state/time&#xa;Gateways/targets enforce actual access" vertex="1">
          <mxGeometry height="250" width="590" x="55" y="660" as="geometry" />
        </mxCell>
        <mxCell id="history" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F5F5F5;strokeColor=#666666;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="PROVENANCE / MERGE / LIFECYCLE HISTORY&#xa;Who asserted or verified a relationship?&#xa;Which source and observation supported it?&#xa;Prior identifiers; merge redirects; split review&#xa;Never reuse retired enterprise IDs&#xa;Preserve evidence without retaining credentials" vertex="1">
          <mxGeometry height="250" width="590" x="55" y="1160" as="geometry" />
        </mxCell>
        <mxCell id="user" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#D5E8D4;strokeColor=#666666;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="USER / CUSTOMER CONTEXT&#xa;Separate entity: identity authority + subject&#xa;Initiator / approver / delegated user relationships&#xa;Do not collapse user and workload identity&#xa;Applicable user rights constrain delegated access&#xa;Session/run references live in execution evidence" vertex="1">
          <mxGeometry height="250" width="590" x="805" y="1160" as="geometry" />
        </mxCell>
        <mxCell id="rule" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F8CECC;strokeColor=#666666;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="CORRELATION AND CARDINALITY RULES&#xa;Agent → platform records: one-to-many&#xa;Platform record → deployments: one-to-many&#xa;Deployment ↔ principal: through verified bindings&#xa;Shared principal: model ambiguity, do not merge agents&#xa;Names/tags are hints; qualified IDs are keys&#xa;enterpriseAgentId is correlation, not a bearer credential" vertex="1">
          <mxGeometry height="250" width="590" x="1555" y="1160" as="geometry" />
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="agent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" target="plat" value="1 → many">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" edge="1" parent="1" source="plat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" target="dep" value="1 → many">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" edge="1" parent="1" source="dep" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" target="binding" value="1 → many bindings">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1850" y="530" />
              <mxPoint x="1100" y="530" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e15" edge="1" parent="1" source="binding" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" target="principal" value="many bindings → referenced principal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" edge="1" parent="1" source="binding" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" target="access" value="Governed entitlement linkage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" edge="1" parent="1" source="agent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" target="access" value="Business accountability">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e18" edge="1" parent="1" source="agent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" target="history" value="Retained history">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="30" y="285" />
              <mxPoint x="30" y="1285" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e19" edge="1" parent="1" source="user" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" target="binding" value="Delegation / interaction relationship">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="example" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F5F5F5;strokeColor=#666666;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="ILLUSTRATIVE EXAMPLE: Customer Refund Assistant = one enterprise agent; production/test = separate deployments; AgentCore workload IDs and IAM roles = identity references; optional Microsoft integration = another verified identity binding. A customer OIDC subject is user context, not the agent ID. Two unrelated agents sharing a technical account remain distinct enterprise agents and generate a shared-identity risk/ambiguity finding." vertex="1">
          <mxGeometry height="130" width="2090" x="55" y="1510" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="5" name="05 | Evidence, scope and implementation acceptance">
    <mxGraphModel dx="2175" dy="2474" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#DAE8FC;strokeColor=#666666;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="05 | Evidence, scope and implementation acceptance&#xa;Source pointers support capability categories; they do not prove installed configuration, connector completeness, write-back or runtime enforcement." vertex="1">
          <mxGeometry height="90" width="2120" x="35" y="25" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#DAE8FC;strokeColor=#666666;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="SERVICENOW — NATIVE INVENTORY / DISCOVERY CATEGORY&#xa;AI Control Tower discovery and external platform connections. Verify release, licensed features, supported record classes, writable external-ID fields and extension contracts.&#xa;https://www.servicenow.com/docs/r/australia/intelligent-experiences/aict-exploring.html&#xa;https://learning.servicenow.com/lxp/en/servicenow-ai-platform/ai-control-tower-aict-discover?id=learning_path_prev&amp;path_id=5947e5304765cfd495898641026d43bf" vertex="1">
          <mxGeometry height="230" width="1030" x="55" y="165" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E1D5E7;strokeColor=#666666;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="SAILPOINT — REGISTRY / RELATIONSHIPS / CONNECTOR CATEGORY&#xa;Agentic Fabric registry, agent relationships and governance. Validate exact certification scope, connector object types and fulfillment support.&#xa;https://documentation.sailpoint.com/saas/help/agentic_fabric/nhi/agent_registry.html&#xa;https://documentation.sailpoint.com/saas/help/agentic_fabric/index.html&#xa;https://documentation.sailpoint.com/connectors/saas/msentraid/help/saas_connectivity/microsoft_entra_id/microsoft_agent_365_catalog.html" vertex="1">
          <mxGeometry height="230" width="1010" x="1135" y="165" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#D5E8D4;strokeColor=#666666;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="AWS — ACCOUNT-SCOPED WORKLOAD IDENTITIES&#xa;AgentCore workload identity directory and identity management; not assumed universal enterprise identity.&#xa;https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/identity-manage-agent-ids.html&#xa;https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/agent-identity-directory.html&#xa;https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/understanding-agent-identities.html" vertex="1">
          <mxGeometry height="220" width="1030" x="55" y="470" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#D5E8D4;strokeColor=#666666;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="MICROSOFT — AGENT IDENTITY VS BLUEPRINT&#xa;Entra agent identity is a specialized principal; blueprint and agent are separate objects. Agent 365 catalog reference is modeled separately.&#xa;https://learn.microsoft.com/en-us/entra/agent-id/agent-identities&#xa;https://learn.microsoft.com/en-us/entra/agent-id/agent-blueprint" vertex="1">
          <mxGeometry height="220" width="1010" x="1135" y="470" as="geometry" />
        </mxCell>
        <mxCell id="a1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#666666;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="ACCEPTANCE TESTS — REGISTRATION / CORRELATION&#xa;1. Planned and discovered objects converge without duplicate approved agents.&#xa;2. Same display name in two tenants does not merge.&#xa;3. Shared IAM role/client does not collapse separate agents.&#xa;4. Binding is verified before use in runtime authorization.&#xa;5. Ownership changes and platform migration retain enterprise ID.&#xa;6. Unsupported connector path is visible, not silently treated as covered." vertex="1">
          <mxGeometry height="250" width="1030" x="55" y="790" as="geometry" />
        </mxCell>
        <mxCell id="a2" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#666666;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="ACCEPTANCE TESTS — GOVERNANCE / REVOCATION&#xa;7. Review decision reaches the actual target and is verified.&#xa;8. SaaS paths bypassing gateway are mapped to native controls or gaps.&#xa;9. Failed/partial revoke remains an open exception.&#xa;10. Stale mapping and policy versions alert and enforce risk-specific failure rules.&#xa;11. Logs join enterprise ID, deployment, principal and trace.&#xa;12. Retirement retains history and verifies required disable/revoke actions." vertex="1">
          <mxGeometry height="250" width="1010" x="1135" y="790" as="geometry" />
        </mxCell>
        <mxCell id="limit" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F8CECC;strokeColor=#666666;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="EXPLICIT LIMITATIONS / DECISIONS&#xa;Oasis Security, SlashID and Microsoft are candidates, not verified interchangeable NHI products. Workato, Agentforce, Okta, Cognito and Cursor-specific API/connector coverage is not established by these diagrams. Product authoring categories are not identity contracts. Existing native integrations must be tested before sizing custom development. No specific cloud database, message bus, universal token exchange, SCIM-for-agents contract or instant revocation SLA is assumed.&#xa;&#xa;Agree who owns enterprise ID issuance, catalog schema, binding verification, ambiguous-match review, synchronization conflicts, per-platform revoke authority and emergency response. Set measurable discovery, mapping-freshness and revocation budgets." vertex="1">
          <mxGeometry height="250" width="2090" x="55" y="1160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
