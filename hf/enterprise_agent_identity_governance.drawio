            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e23" edge="1" parent="1" source="store" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" target="runtimeMap" value="Verified active projection">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1380" y="870" />
              <mxPoint x="280" y="870" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e24" edge="1" parent="1" source="runtimeMap" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" target="gateway" value="Versioned mapping / cache invalidation">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e25" edge="1" parent="1" source="gateway" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" target="native" value="Authorized request where routed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e26" edge="1" parent="1" source="native" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" target="obs" value="Actual target result">
          <mxGeometry relative="1" as="geometry" />
