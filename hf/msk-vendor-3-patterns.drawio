        <mxCell id="p1-title" value="Pattern 1 — Enterprise-to-Vendor Delta Delivery" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#102A43;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="18" width="1700" height="42"/>
        </mxCell>
        <mxCell id="p1-sub" value="Cohere Health use case: publish enterprise deltas once; use either direct vendor pull from MSK or enterprise-managed push to a vendor target." style="text;html=1;align=left;fontSize=15;fontColor=#536B7D;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="47" y="62" width="1760" height="30"/>
        </mxCell>
        <mxCell id="p1-l1" value="YOUR COMPANY — DOMAIN / DATA PRODUCT" style="swimlane;html=1;horizontal=0;startSize=46;fillColor=#0798B5;swimlaneFillColor=#F8FBFC;fontColor=#FFFFFF;fontStyle=1;fontSize=13;rounded=0;collapsible=0;separatorColor=#D5E4E9;strokeColor=#A8C6D0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="105" width="1910" height="220"/>
        </mxCell>
        <mxCell id="p1-l2" value="YOUR COMPANY — MSK + INTEGRATION PRODUCT" style="swimlane;html=1;horizontal=0;startSize=46;fillColor=#1E293B;swimlaneFillColor=#F8FBFC;fontColor=#FFFFFF;fontStyle=1;fontSize=13;rounded=0;collapsible=0;separatorColor=#D5E4E9;strokeColor=#A8C6D0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="350" width="1910" height="220"/>
        </mxCell>
        <mxCell id="p1-l3" value="VENDOR EDGE / CONNECTIVITY" style="swimlane;html=1;horizontal=0;startSize=46;fillColor=#2563EB;swimlaneFillColor=#F8FBFC;fontColor=#FFFFFF;fontStyle=1;fontSize=13;rounded=0;collapsible=0;separatorColor=#D5E4E9;strokeColor=#A8C6D0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="595" width="1910" height="220"/>
        </mxCell>
        <mxCell id="p1-l4" value="COHERE HEALTH / OTHER VENDOR" style="swimlane;html=1;horizontal=0;startSize=46;fillColor=#7C3AED;swimlaneFillColor=#F8FBFC;fontColor=#FFFFFF;fontStyle=1;fontSize=13;rounded=0;collapsible=0;separatorColor=#D5E4E9;strokeColor=#A8C6D0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="840" width="1910" height="220"/>
        </mxCell>
        <mxCell id="p1-n1" value="&lt;b&gt;1. Commit source change&lt;/b&gt;&lt;br&gt;System of record commits business state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0798B5;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p1-l1" vertex="1">
          <mxGeometry as="geometry" x="65" y="55" width="225" height="105"/>
        </mxCell>
        <mxCell id="p1-n2" value="&lt;b&gt;2. Capture committed delta&lt;/b&gt;&lt;br&gt;Transactional outbox or approved CDC; large documents become object references" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p1-l1" vertex="1">
          <mxGeometry as="geometry" x="350" y="48" width="260" height="118"/>
        </mxCell>
        <mxCell id="p1-n3" value="&lt;b&gt;3. Build event contract&lt;/b&gt;&lt;br&gt;Stable key, event ID, source version, trace, classification, minimized payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0798B5;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p1-l1" vertex="1">
          <mxGeometry as="geometry" x="680" y="48" width="275" height="118"/>
        </mxCell>
        <mxCell id="p1-n4" value="&lt;b&gt;4. Publish to MSK&lt;/b&gt;&lt;br&gt;Canonical domain topic or vendor projection topic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p1-l2" vertex="1">
          <mxGeometry as="geometry" x="680" y="48" width="275" height="118"/>
        </mxCell>
        <mxCell id="p1-n5" value="&lt;b&gt;5. Apply product controls&lt;/b&gt;&lt;br&gt;Schema gate, retention, partitions, KMS/TLS, ACLs, quota, metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p1-l2" vertex="1">
          <mxGeometry as="geometry" x="1015" y="48" width="260" height="118"/>
        </mxCell>
        <mxCell id="p1-d1" value="&lt;b&gt;Vendor supports direct Kafka?&lt;/b&gt;&lt;br&gt;Client + network + auth + offsets + support" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#CA8A04;strokeWidth=2;fontColor=#102A43;fontSize=11;align=center;verticalAlign=middle;spacing=4;" parent="p1-l2" vertex="1">
          <mxGeometry as="geometry" x="1335" y="38" width="215" height="138"/>
        </mxCell>
        <mxCell id="p1-n6b" value="&lt;b&gt;6B. Managed sink / relay&lt;/b&gt;&lt;br&gt;MSK Connect sink or custom relay pushes approved delta to vendor target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p1-l2" vertex="1">
          <mxGeometry as="geometry" x="1610" y="48" width="235" height="118"/>
        </mxCell>
        <mxCell id="p1-n6a" value="&lt;b&gt;6A. Private MSK access&lt;/b&gt;&lt;br&gt;Managed VPC/approved path; client identity; topic + group authorization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p1-l3" vertex="1">
          <mxGeometry as="geometry" x="1335" y="48" width="230" height="118"/>
        </mxCell>
        <mxCell id="p1-n7a" value="&lt;b&gt;7A. Vendor consumer polls&lt;/b&gt;&lt;br&gt;Dedicated group; backpressure is represented by consumer lag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p1-l3" vertex="1">
          <mxGeometry as="geometry" x="1610" y="48" width="235" height="118"/>
        </mxCell>
        <mxCell id="p1-n7b" value="&lt;b&gt;7B. Push to target endpoint&lt;/b&gt;&lt;br&gt;Private API/queue; retry policy, idempotency key and delivery receipt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p1-l3" vertex="1">
          <mxGeometry as="geometry" x="1015" y="48" width="260" height="118"/>
        </mxCell>
        <mxCell id="p1-n8" value="&lt;b&gt;8. Validate and deduplicate&lt;/b&gt;&lt;br&gt;Schema + authorization context + event ID/source version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p1-l4" vertex="1">
          <mxGeometry as="geometry" x="1335" y="48" width="230" height="118"/>
        </mxCell>
        <mxCell id="p1-n9" value="&lt;b&gt;9. AI / agentic workflow&lt;/b&gt;&lt;br&gt;Process authorized delta and persist vendor checkpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p1-l4" vertex="1">
          <mxGeometry as="geometry" x="1610" y="48" width="235" height="118"/>
        </mxCell>
        <mxCell id="p1-n10" value="&lt;b&gt;10. Optional acknowledgment&lt;/b&gt;&lt;br&gt;Return receipt/status through result topic or enterprise callback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p1-l4" vertex="1">
