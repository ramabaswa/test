  <diagram id="p2" name="3 - Pattern 2 Pull from Vendor Source">
    <mxGraphModel dx="2000" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p2-title" value="Pattern 2 — Pull from Vendor Source" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#102A43;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="18" width="1700" height="42"/>
        </mxCell>
        <mxCell id="p2-sub" value="The enterprise owns the polling/subscription cadence, inbound checkpoint, normalization, and publication into governed MSK topics." style="text;html=1;align=left;fontSize=15;fontColor=#536B7D;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="47" y="62" width="1760" height="30"/>
        </mxCell>
        <mxCell id="p2-l1" value="COHERE HEALTH / OTHER VENDOR — SOURCE SYSTEM" style="swimlane;html=1;horizontal=0;startSize=46;fillColor=#7C3AED;swimlaneFillColor=#F8FBFC;fontColor=#FFFFFF;fontStyle=1;fontSize=13;rounded=0;collapsible=0;separatorColor=#D5E4E9;strokeColor=#A8C6D0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="105" width="1910" height="220"/>
        </mxCell>
        <mxCell id="p2-l2" value="YOUR COMPANY — VENDOR EDGE / INTEGRATION" style="swimlane;html=1;horizontal=0;startSize=46;fillColor=#2563EB;swimlaneFillColor=#F8FBFC;fontColor=#FFFFFF;fontStyle=1;fontSize=13;rounded=0;collapsible=0;separatorColor=#D5E4E9;strokeColor=#A8C6D0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="350" width="1910" height="220"/>
        </mxCell>
        <mxCell id="p2-l3" value="YOUR COMPANY — AMAZON MSK PRODUCT" style="swimlane;html=1;horizontal=0;startSize=46;fillColor=#1E293B;swimlaneFillColor=#F8FBFC;fontColor=#FFFFFF;fontStyle=1;fontSize=13;rounded=0;collapsible=0;separatorColor=#D5E4E9;strokeColor=#A8C6D0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="595" width="1910" height="220"/>
        </mxCell>
        <mxCell id="p2-l4" value="YOUR COMPANY — DOMAIN CONSUMERS / TARGETS" style="swimlane;html=1;horizontal=0;startSize=46;fillColor=#0798B5;swimlaneFillColor=#F8FBFC;fontColor=#FFFFFF;fontStyle=1;fontSize=13;rounded=0;collapsible=0;separatorColor=#D5E4E9;strokeColor=#A8C6D0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="840" width="1910" height="220"/>
        </mxCell>
        <mxCell id="p2-n1" value="&lt;b&gt;1. Create vendor delta&lt;/b&gt;&lt;br&gt;Vendor source commits a change and exposes change token, timestamp, webhook, API or changelog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p2-l1" vertex="1">
          <mxGeometry as="geometry" x="70" y="48" width="245" height="118"/>
        </mxCell>
        <mxCell id="p2-n2" value="&lt;b&gt;2. Authorize source access&lt;/b&gt;&lt;br&gt;Vendor API identity, scopes, rate limits, purpose and source contract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p2-l1" vertex="1">
          <mxGeometry as="geometry" x="380" y="48" width="245" height="118"/>
        </mxCell>
        <mxCell id="p2-n3" value="&lt;b&gt;3. Poll or subscribe&lt;/b&gt;&lt;br&gt;MSK Connect source connector or custom polling adapter uses saved cursor/checkpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p2-l2" vertex="1">
          <mxGeometry as="geometry" x="380" y="48" width="245" height="118"/>
        </mxCell>
        <mxCell id="p2-n4" value="&lt;b&gt;4. Land and validate&lt;/b&gt;&lt;br&gt;Raw/quarantine boundary; signature, schema, malware/content checks, duplicate detection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p2-l2" vertex="1">
          <mxGeometry as="geometry" x="690" y="48" width="260" height="118"/>
        </mxCell>
        <mxCell id="p2-n5" value="&lt;b&gt;5. Normalize inbound event&lt;/b&gt;&lt;br&gt;Map vendor model to enterprise contract; add vendor ID, event ID, source cursor and trace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p2-l2" vertex="1">
          <mxGeometry as="geometry" x="1015" y="48" width="260" height="118"/>
        </mxCell>
        <mxCell id="p2-n6" value="&lt;b&gt;6. Publish inbound topic&lt;/b&gt;&lt;br&gt;Vendor inbound or canonical domain event after ownership/semantic approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p2-l3" vertex="1">
          <mxGeometry as="geometry" x="1015" y="48" width="260" height="118"/>
        </mxCell>
        <mxCell id="p2-n7" value="&lt;b&gt;7. Govern and observe&lt;/b&gt;&lt;br&gt;Schema, retention, KMS/TLS, ACLs, partitions, quotas, freshness and connector lag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p2-l3" vertex="1">
          <mxGeometry as="geometry" x="1340" y="48" width="250" height="118"/>
        </mxCell>
        <mxCell id="p2-n8" value="&lt;b&gt;8. Enterprise consumers poll&lt;/b&gt;&lt;br&gt;Dedicated groups for workflow, analytics, audit or system-of-record update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0798B5;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p2-l4" vertex="1">
          <mxGeometry as="geometry" x="1340" y="48" width="250" height="118"/>
        </mxCell>
        <mxCell id="p2-n9" value="&lt;b&gt;9. Apply idempotently&lt;/b&gt;&lt;br&gt;Use event ID + vendor cursor/version; persist processing checkpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0798B5;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p2-l4" vertex="1">
          <mxGeometry as="geometry" x="1645" y="48" width="215" height="118"/>
        </mxCell>
        <mxCell id="p2-n10" value="&lt;b&gt;10. Advance source cursor&lt;/b&gt;&lt;br&gt;Only after durable landing/publication according to selected delivery guarantee" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p2-l2" vertex="1">
          <mxGeometry as="geometry" x="1645" y="48" width="215" height="118"/>
        </mxCell>
