  <diagram id="p3" name="4 - Pattern 3 Bidirectional">
    <mxGraphModel dx="2000" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p3-title" value="Pattern 3 — Bidirectional Command, Status and Result" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#102A43;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="45" y="18" width="1700" height="42"/>
        </mxCell>
        <mxCell id="p3-sub" value="Two independent event flows form one business conversation; neither direction shares consumer groups, credentials, topics, or replay policy." style="text;html=1;align=left;fontSize=15;fontColor=#536B7D;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="47" y="62" width="1760" height="30"/>
        </mxCell>
        <mxCell id="p3-l1" value="YOUR COMPANY — BUSINESS / DOMAIN WORKFLOW" style="swimlane;html=1;horizontal=0;startSize=46;fillColor=#0798B5;swimlaneFillColor=#F8FBFC;fontColor=#FFFFFF;fontStyle=1;fontSize=13;rounded=0;collapsible=0;separatorColor=#D5E4E9;strokeColor=#A8C6D0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="105" width="1910" height="220"/>
        </mxCell>
        <mxCell id="p3-l2" value="YOUR COMPANY — MSK + INTEGRATION PRODUCT" style="swimlane;html=1;horizontal=0;startSize=46;fillColor=#1E293B;swimlaneFillColor=#F8FBFC;fontColor=#FFFFFF;fontStyle=1;fontSize=13;rounded=0;collapsible=0;separatorColor=#D5E4E9;strokeColor=#A8C6D0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="350" width="1910" height="220"/>
        </mxCell>
        <mxCell id="p3-l3" value="VENDOR EDGE / CONNECTIVITY" style="swimlane;html=1;horizontal=0;startSize=46;fillColor=#2563EB;swimlaneFillColor=#F8FBFC;fontColor=#FFFFFF;fontStyle=1;fontSize=13;rounded=0;collapsible=0;separatorColor=#D5E4E9;strokeColor=#A8C6D0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="595" width="1910" height="220"/>
        </mxCell>
        <mxCell id="p3-l4" value="COHERE HEALTH / OTHER VENDOR" style="swimlane;html=1;horizontal=0;startSize=46;fillColor=#7C3AED;swimlaneFillColor=#F8FBFC;fontColor=#FFFFFF;fontStyle=1;fontSize=13;rounded=0;collapsible=0;separatorColor=#D5E4E9;strokeColor=#A8C6D0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="840" width="1910" height="220"/>
        </mxCell>
        <mxCell id="p3-n1" value="&lt;b&gt;1. Business trigger&lt;/b&gt;&lt;br&gt;Create authorization/work item and immutable workflow ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0798B5;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p3-l1" vertex="1">
          <mxGeometry as="geometry" x="55" y="48" width="220" height="118"/>
        </mxCell>
        <mxCell id="p3-n2" value="&lt;b&gt;2. Build command/delta&lt;/b&gt;&lt;br&gt;Event ID, correlation ID, causation ID, source version, classification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0798B5;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p3-l1" vertex="1">
          <mxGeometry as="geometry" x="330" y="48" width="240" height="118"/>
        </mxCell>
        <mxCell id="p3-n3" value="&lt;b&gt;3. Publish outbound topic&lt;/b&gt;&lt;br&gt;Command or delta topic; schema gate, retention, ACL, quota" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p3-l2" vertex="1">
          <mxGeometry as="geometry" x="330" y="48" width="240" height="118"/>
        </mxCell>
        <mxCell id="p3-n4" value="&lt;b&gt;4. Deliver outbound&lt;/b&gt;&lt;br&gt;Vendor direct consumer &lt;b&gt;or&lt;/b&gt; enterprise sink/relay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p3-l3" vertex="1">
          <mxGeometry as="geometry" x="630" y="48" width="235" height="118"/>
        </mxCell>
        <mxCell id="p3-n5" value="&lt;b&gt;5. Accept and checkpoint&lt;/b&gt;&lt;br&gt;Deduplicate; persist workflow intake before committing/acknowledging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p3-l4" vertex="1">
          <mxGeometry as="geometry" x="930" y="48" width="235" height="118"/>
        </mxCell>
        <mxCell id="p3-n6" value="&lt;b&gt;6. AI / agentic processing&lt;/b&gt;&lt;br&gt;Execute purpose-bound workflow; emit progress or request-more-information" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p3-l4" vertex="1">
          <mxGeometry as="geometry" x="1225" y="48" width="235" height="118"/>
        </mxCell>
        <mxCell id="p3-n7" value="&lt;b&gt;7. Produce status / result&lt;/b&gt;&lt;br&gt;Ack, progress, RFI, decision, error or derived event; vendor result version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p3-l4" vertex="1">
          <mxGeometry as="geometry" x="1530" y="48" width="250" height="118"/>
        </mxCell>
        <mxCell id="p3-n8" value="&lt;b&gt;8. Deliver inbound&lt;/b&gt;&lt;br&gt;Vendor producer to MSK &lt;b&gt;or&lt;/b&gt; enterprise source adapter polls vendor result API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p3-l3" vertex="1">
          <mxGeometry as="geometry" x="1530" y="48" width="250" height="118"/>
        </mxCell>
        <mxCell id="p3-n9" value="&lt;b&gt;9. Validate inbound event&lt;/b&gt;&lt;br&gt;Authorize producer, schema check, correlate, quarantine invalid result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p3-l2" vertex="1">
          <mxGeometry as="geometry" x="1225" y="48" width="235" height="118"/>
        </mxCell>
        <mxCell id="p3-n10" value="&lt;b&gt;10. Publish result topic&lt;/b&gt;&lt;br&gt;Separate status/result topic, key by workflow ID, independent retention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p3-l2" vertex="1">
          <mxGeometry as="geometry" x="930" y="48" width="235" height="118"/>
        </mxCell>
        <mxCell id="p3-n11" value="&lt;b&gt;11. Consume result&lt;/b&gt;&lt;br&gt;Enterprise result consumer validates transition and idempotency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0798B5;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p3-l1" vertex="1">
          <mxGeometry as="geometry" x="630" y="48" width="235" height="118"/>
        </mxCell>
        <mxCell id="p3-n12" value="&lt;b&gt;12. Update source of truth&lt;/b&gt;&lt;br&gt;Apply decision/status; reconcile lifecycle; close or continue conversation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0798B5;strokeWidth=2;fontColor=#102A43;fontSize=12;align=center;verticalAlign=middle;spacing=8;" parent="p3-l1" vertex="1">
          <mxGeometry as="geometry" x="55" y="48" width="220" height="118"/>
        </mxCell>
        <mxCell id="p3-corr" value="&lt;b&gt;Conversation contract:&lt;/b&gt; workflowId/correlationId links both directions • eventId identifies each immutable message • causationId links response to request • sourceVersion/vendorResultVersion prevent stale updates • traceId links observability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontColor=#5B21B6;fontSize=11;align=center;spacing=8;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="265" y="1075" width="1470" height="58"/>
        </mxCell>
        <mxCell id="p3-o0" value="OUT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0798B5;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#0798B5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="p3-n1" target="p3-n2">
