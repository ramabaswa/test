        <mxCell id="pc0" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;P1 — Enterprise → Vendor&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;Outbound delta delivery&lt;/b&gt;&lt;br&gt;Vendor pulls from MSK &lt;b&gt;or&lt;/b&gt; enterprise pushes through sink/relay.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#536B7D&quot;&gt;Canonical/projection topic → dedicated consumer group or vendor target&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0798B5;strokeWidth=2;fontColor=#102A43;fontSize=11;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="75" y="735" width="570" height="250"/>
        </mxCell>
        <mxCell id="pc1" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;P2 — Vendor → Enterprise&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;Pull from vendor source&lt;/b&gt;&lt;br&gt;Enterprise-controlled connector/adapter polls or subscribes, checkpoints externally, and publishes inbound events.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#536B7D&quot;&gt;Vendor API/source → source connector → inbound topic → enterprise consumers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=2;fontColor=#102A43;fontSize=11;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="695" y="735" width="570" height="250"/>
        </mxCell>
        <mxCell id="pc2" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;P3 — Bidirectional&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;Command / status / result&lt;/b&gt;&lt;br&gt;Separate topics and identities for each direction; correlate by workflow ID, event ID and causation ID.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#536B7D&quot;&gt;Enterprise command → vendor workflow → status/result → enterprise state&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#102A43;fontSize=11;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1315" y="735" width="570" height="250"/>
        </mxCell>
        <mxCell id="decision" value="&lt;b&gt;Selection rule:&lt;/b&gt; choose the simplest supported pattern that meets vendor capability, PHI boundary, latency, recovery, support ownership, and contractual obligations. Direct Cohere Kafka consumption remains a discovery decision—not an assumption." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#CA8A04;fontColor=#7C4A03;fontSize=12;align=center;spacing=10;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="170" y="1015" width="1660" height="70"/>
        </mxCell>
        <mxCell id="c-ctrl" value="&lt;b&gt;Shared controls:&lt;/b&gt; Entra ID for enterprise portals/control APIs • Kafka client identity for MSK data plane • least-privilege topic/group ACLs • TLS/KMS • schema gates • PHI minimization • quotas • logs/metrics/traces • reconciliation • approved replay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F6F8;strokeColor=#9BD9E2;fontColor=#24515A;fontSize=11;align=center;spacing=8;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="80" y="1105" width="1840" height="55"/>
        </mxCell>
